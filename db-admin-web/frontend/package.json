{
  "name": "ai-platform-db-admin",
  "version": "1.0.0",
  "description": "智映教匠AI平台数据库管理系统前端",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "check-port": "lsof -ti:5173 && echo '❌ 端口5173被占用！请停止现有服务或使用 npm run kill-port' && exit 1 || echo '✅ 端口5173可用'",
    "kill-port": "lsof -ti:5173 | xargs kill -9 2>/dev/null && echo '✅ 已清理端口5173' || echo '✅ 端口5173未被占用'",
    "dev": "npm run check-port && vite",
    "dev-force": "npm run kill-port && vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "react",
    "database",
    "admin",
    "management"
  ],
  "author": "智映教匠开发团队",
  "license": "MIT",
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "axios": "^1.7.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  }
}
